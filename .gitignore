# ignore output files
*.txt
*.csv

# ignore helper output
*.json

# sqlite database
*.db

# don't ignore config files
!config.json
!.devcontainer/devcontainer.json
!.vscode/settings.json
!src/metadata_scrapper/models/*.json

## uv / python
.venv/
__pycache__/
*.py[cod]

# opencode: see .opencode/.gitignore for the local-exclusion rules

# impeccable design workspace (local working state; decision history stays in git history)
.impeccable/

# sqlite WAL sidecars
metadata.db-shm
metadata.db-wal

# node (ui build artifacts are rebuilt from source)
node_modules/
dist/

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit test / coverage reports
.coverage
.coverage.*
.pytest_cache/
.ruff_cache/
htmlcov/

# Environments
.env
.venv
env/
venv/

# Editors
.idea/

# test media (copyright, too large for git)
testdata/

# generated reports
report.html
